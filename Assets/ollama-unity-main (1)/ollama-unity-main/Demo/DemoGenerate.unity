  m_text: "<align=center><size=200%>Generate Demo</size></align>\n\nThis demo first
    calls <b>Ollama.List()</b> to populate the <b>Dropdown</b> with all the available
    models. \nYou can then ask simple question using the selected model. Note that
    this does not retain any conversation.\nClick the <b>[ 1 + 1 ]</b> button to
    perform a simple calculation. This is meant to showcase the JSON format. Check
    the code of the <b>OnMath()</b> function for details."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
